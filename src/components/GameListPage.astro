---
import GameCard from './GameCard.astro';
import EmptyState from './EmptyState.astro';
import type { Game } from '../types/game';

interface Props {
    games: Game[];
    currentPage: number;
    totalPages: number;
}

const { games, currentPage, totalPages } = Astro.props;
const previousPage = currentPage - 1;
const nextPage = currentPage + 1;

function pageHref(page: number): string {
    return page === 1 ? '/' : `/page/${page}`;
}
---

<div class="pb-8">
    <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

    {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
    ) : (
        <>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
                {games.map((game) => <GameCard game={game} />)}
            </div>

            {totalPages > 1 && (
                <nav aria-label="Game list pagination" data-testid="pagination" class="mt-8 flex items-center justify-center gap-4">
                    {currentPage > 1 ? (
                        <a
                            href={pageHref(previousPage)}
                            aria-label="Go to previous page"
                            data-testid="pagination-previous"
                            class="rounded-lg border border-slate-600 px-4 py-2 text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        >
                            Previous
                        </a>
                    ) : (
                        <span class="rounded-lg border border-slate-700 px-4 py-2 text-slate-400" aria-hidden="true">Previous</span>
                    )}

                    <span class="text-slate-300" aria-current="page" data-testid="pagination-status">
                        Page {currentPage} of {totalPages}
                    </span>

                    {currentPage < totalPages ? (
                        <a
                            href={pageHref(nextPage)}
                            aria-label="Go to next page"
                            data-testid="pagination-next"
                            class="rounded-lg border border-slate-600 px-4 py-2 text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        >
                            Next
                        </a>
                    ) : (
                        <span class="rounded-lg border border-slate-700 px-4 py-2 text-slate-400" aria-hidden="true">Next</span>
                    )}
                </nav>
            )}
        </>
    )}
</div>
