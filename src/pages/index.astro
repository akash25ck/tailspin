---
import Layout from '../layouts/Layout.astro';
import GameListPage from '../components/GameListPage.astro';
import PageHero from '../components/PageHero.astro';
import { getDatabase } from '../lib/db';
import { GAMES_PER_PAGE, getGameCount, getGamesPage } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getGamesPage(db, 1, GAMES_PER_PAGE);
const totalPages = Math.ceil(await getGameCount(db) / GAMES_PER_PAGE);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <GameListPage games={games} currentPage={1} totalPages={totalPages} />
  </div>
</Layout>
